rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      // Allow basic read access relying on the frontend to block 'Disabled'.
      // This prevents the claim-sync deadlock when fetching their own profile.
      return request.auth != null;
    }

    function hasRole(role) {
      return isSignedIn() && request.auth.token.role == role;
    }

    function isManagement() {
      return isSignedIn()
        && (
          request.auth.token.role == 'HOD'
          || request.auth.token.role == 'Manager'
          || request.auth.token.role == 'Chief Manager'
        );
    }

    function hasPermission(permission) {
      return isSignedIn()
        && (
          request.auth.token.role == 'HOD'
          || request.auth.token.permissions[permission] == true
        );
    }

    function sameUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if sameUser(userId) || hasPermission('manageUsers') || hasPermission('accessAllDepartments');
      allow create, update, delete: if false;
    }

    match /test_requests/{requestId} {
      allow read: if isSignedIn();
      allow create, update, delete: if false;
    }

    match /costing/{costingId} {
      allow read: if hasPermission('viewCosting');
      allow write: if false;

      match /versions/{versionId} {
        allow read: if hasPermission('viewCosting');
        allow write: if false;
      }
    }

    match /assignments/{assignmentId} {
      allow read: if isManagement()
        || hasRole('HOD')
        || hasRole('Commercial')
        || (hasRole('Engineer') && resource.data.engineerUid == request.auth.uid);
      allow write: if false;
    }

    match /reports/{reportId} {
      allow read: if isManagement()
        || hasRole('HOD')
        || hasRole('Commercial')
        || (hasRole('Engineer') && resource.data.engineerUid == request.auth.uid);
      allow write: if false;
    }

    match /audit_logs/{logId} {
      allow read: if hasPermission('manageAuditLogs');
      allow write: if false;
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /system_counters/{docId} {
      allow read, write: if false;
    }

    match /system/{docId} {
      allow read, write: if hasRole('HOD');
    }

    match /costing_master/{docId} {
      allow read: if hasPermission('viewCosting') || hasPermission('editCosting');
      allow write: if hasPermission('editCosting');
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
